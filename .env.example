# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps interactive maps
GOOGLE_MAPS_PLATFORM_KEY=

# MERCADOPAGO_ACCESS_TOKEN: Mercado Pago Private Access Token for payment preferences & Webhooks (Chile MLC)
# Example: APP_USR-7829104829104829-082219-xxxxxxxxxxxx-781053984
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_PUBLIC_KEY: Mercado Pago Public Key for client-side Checkout Pro / Bricks / Webpay
# Example: APP_USR-xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=

# MERCADOPAGO_CLIENT_ID: Mercado Pago Application Client ID
MERCADOPAGO_CLIENT_ID=

# MERCADOPAGO_CLIENT_SECRET: Mercado Pago Application Client Secret
MERCADOPAGO_CLIENT_SECRET=

# MERCADOLIBRE_ACCESS_TOKEN: Mercado Libre REST API Access Token for articles sync (Chile MLC)
# Example: APP_USR-7829104829104829-082219-a1b2c3d4e5f6-781053984
MERCADOLIBRE_ACCESS_TOKEN=

# MERCADOLIBRE_APP_ID: Mercado Libre Developer App ID (Client ID)
MERCADOLIBRE_APP_ID=

# MERCADOLIBRE_CLIENT_SECRET: Mercado Libre Developer App Secret Key
MERCADOLIBRE_CLIENT_SECRET=

# MERCADOLIBRE_USER_ID: Mercado Libre Seller User ID (e.g. 781053984)
MERCADOLIBRE_USER_ID=

# MERCADOLIBRE_SITE_ID: Mercado Libre Site (MLC for Chile)
MERCADOLIBRE_SITE_ID=MLC
